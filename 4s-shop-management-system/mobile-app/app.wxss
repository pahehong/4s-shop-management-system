/**
 * 4S店管理系统 - 微信小程序 - 全局样式
 */

/* 全局样式 */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
}

.page-body {
  flex: 1;
  padding: 20rpx;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #007AFF;
  color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  text-align: center;
  margin: 20rpx 0;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border-radius: 10rpx;
  padding: 20rpx;
  text-align: center;
  margin: 20rpx 0;
}

/* 通用卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 通用列表项样式 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

/* 通用标题样式 */
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

/* 通用副标题样式 */
.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

/* 通用文本样式 */
.text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 通用输入框样式 */
.input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  margin: 10rpx 0;
  background-color: white;
}

/* 通用分割线 */
.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* 通用加载样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

/* 通用错误样式 */
.error {
  color: #ff4757;
  font-size: 24rpx;
  margin: 10rpx 0;
}

/* 通用成功样式 */
.success {
  color: #2ed573;
  font-size: 24rpx;
  margin: 10rpx 0;
}

/* 通用警告样式 */
.warning {
  color: #ffa502;
  font-size: 24rpx;
  margin: 10rpx 0;
}
